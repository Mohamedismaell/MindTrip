{
  "version": 8,

  "name": "MindTrip Editorial",

  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",

  "sprite": "mapbox://sprites/mapbox/streets-v8",

  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8",
      "type": "vector"
    }
  },

  "layers": [

    {
      "id": "background",
      "type": "background",

      "paint": {
        "background-color": "#F4F4F2"
      }
    },

    {
      "id": "water",
      "type": "fill",

      "source": "composite",
      "source-layer": "water",

      "paint": {
        "fill-color": "#D8ECF5"
      }
    },

    {
      "id": "parks",
      "type": "fill",

      "source": "composite",
      "source-layer": "landuse",

      "filter": [
        "match",
        ["get", "class"],
        [
          "park",
          "grass",
          "pitch"
        ],
        true,
        false
      ],

      "paint": {
        "fill-color": "#CFE8D3",
        "fill-opacity": 0.65
      }
    },

    {
      "id": "buildings",
      "type": "fill",

      "source": "composite",
      "source-layer": "building",

      "paint": {
        "fill-color": "#E8E8E6",

        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.55,
          14, 0.68,
          16, 0.78
        ]
      }
    },

    {
      "id": "roads-main",

      "type": "line",

      "source": "composite",
      "source-layer": "road",

      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },

      "filter": [
        "match",
        ["get", "class"],
        [
          "motorway",
          "motorway_link",
          "trunk",
          "trunk_link",
          "primary",
          "secondary",
          "tertiary"
        ],
        true,
        false
      ],

      "paint": {

        "line-color": "#FCFCFC",

        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 1.2,
          14, 2.2,
          16, 3.8
        ],

        "line-opacity": 1
      }
    },

    {
      "id": "roads-small",

      "type": "line",

      "source": "composite",
      "source-layer": "road",

      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },

      "filter": [
        "match",
        ["get", "class"],
        [
          "street",
          "street_limited",
          "service",
          "link",
          "path"
        ],
        true,
        false
      ],

      "paint": {

        "line-color": "#FFFFFF",

        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9, 0.6,
          14, 1.2,
          16, 2
        ],

        "line-opacity": 1
      }
    },

    {
      "id": "road-labels",

      "type": "symbol",

      "source": "composite",
      "source-layer": "road",

      "layout": {

        "text-field": [
          "coalesce",
          ["get", "name_en"],
          ["get", "name"]
        ],

        "text-font": [
          "Open Sans Regular"
        ],

        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 10,
          16, 14
        ],

        "symbol-placement": "line"
      },

      "paint": {
        "text-color": "#9CA3AF",
        "text-halo-color": "#F4F4F2",
        "text-halo-width": 1
      }
    },

    {
      "id": "place-labels",

      "type": "symbol",

      "source": "composite",
      "source-layer": "place_label",

      "layout": {

        "text-field": [
          "coalesce",
          ["get", "name_en"],
          ["get", "name"]
        ],

        "text-font": [
          "Open Sans Semibold"
        ],

        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3, 12,
          8, 16,
          12, 20
        ]
      },

      "paint": {
        "text-color": "#6B7280",
        "text-halo-color": "#F4F4F2",
        "text-halo-width": 1.2
      }
    },

    {
      "id": "poi-standard",

      "type": "symbol",

      "source": "composite",
      "source-layer": "poi_label",

      "minzoom": 10,

      "layout": {

        "icon-image": [
          "concat",
          ["get", "maki"],
          "-15"
        ],

        "icon-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.7,
          16, 1
        ],

        "text-field": [
          "coalesce",
          ["get", "name_en"],
          ["get", "name"]
        ],

        "text-font": [
          "Open Sans Regular"
        ],

        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 10,
          16, 13
        ],

        "text-offset": [0, 1],

        "text-anchor": "top",

        "symbol-placement": "point"
      },

      "paint": {

        "text-color": "#6B7280",

        "text-halo-color": "#F4F4F2",

        "text-halo-width": 1
      }
    }
  ]
}